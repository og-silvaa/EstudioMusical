### Variables
@baseUrl = http://localhost:8080/api/rooms
@roomId = 69213019c1a4041f53fd2e6e
@contentType = application/json

### ========== ROOMS API ==========

### 1. Listar todas las salas
GET {{baseUrl}}

### 2. Listar solo salas disponibles
GET {{baseUrl}}/available

### 3. Obtener sala por ID
GET {{baseUrl}}/{{roomId}}

### 4. Crear nueva sala
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "name": "Sala de Jazz",
  "description": "Sala acogedora para ensayos de jazz",
  "capacity": 4,
  "pricePerHour": 18.0,
  "availableInstruments": [
    {"name": "Piano", "quantity": 1},
    {"name": "Contrabajo", "quantity": 1},
    {"name": "Batería Jazz", "quantity": 1}
  ],
  "availableMicrophones": [
    {"name": "AKG C414", "quantity": 2},
    {"name": "Shure SM57", "quantity": 3}
  ],
  "available": true
}

### 5. Actualizar sala existente
PUT {{baseUrl}}/{{roomId}}
Content-Type: {{contentType}}

{
  "name": "Sala Rock Actualizada",
  "description": "Sala amplia ideal para bandas de rock - ACTUALIZADA",
  "capacity": 6,
  "pricePerHour": 30.0,
  "availableInstruments": [
    {"name": "Batería", "quantity": 1},
    {"name": "Amplificador Guitarra", "quantity": 3},
    {"name": "Amplificador Bajo", "quantity": 2},
    {"name": "Teclado", "quantity": 1}
  ],
  "availableMicrophones": [
    {"name": "Shure SM58", "quantity": 4},
    {"name": "Shure SM57", "quantity": 3},
    {"name": "Sennheiser e835", "quantity": 2}
  ],
  "available": true
}

### 6. Eliminar sala
DELETE {{baseUrl}}/{{roomId}}

### ========== PRUEBAS CON DATOS DINÁMICOS ==========

### 7. Crear sala con timestamp
# @name nuevaSala
POST {{baseUrl}}
Content-Type: {{contentType}}

{
  "name": "Sala Test {{$timestamp}}",
  "description": "Sala de prueba creada automáticamente",
  "capacity": 3,
  "pricePerHour": 15.0,
  "availableInstruments": [
    {"name": "Guitarra", "quantity": 2}
  ],
  "availableMicrophones": [
    {"name": "Shure SM58", "quantity": 2}
  ],
  "available": true
}

### 8. Obtener la sala recién creada
GET {{baseUrl}}/{{nuevaSala.response.body.id}}

### 9. Actualizar la sala recién creada
PUT {{baseUrl}}/{{nuevaSala.response.body.id}}
Content-Type: {{contentType}}

{
  "name": "Sala Test Actualizada",
  "description": "Sala actualizada desde API test",
  "capacity": 5,
  "pricePerHour": 22.0,
  "availableInstruments": [
    {"name": "Guitarra", "quantity": 2},
    {"name": "Bajo", "quantity": 1},
    {"name": "Batería", "quantity": 1}
  ],
  "availableMicrophones": [
    {"name": "Shure SM58", "quantity": 3},
    {"name": "Shure SM57", "quantity": 2}
  ],
  "available": true
}

### 10. Eliminar la sala recién creada
DELETE {{baseUrl}}/{{nuevaSala.response.body.id}}